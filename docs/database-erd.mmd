    grades ||--o{ questions : "1-N"
    types ||--o{ questions : "1-N"

    users ||--o{ user_lesson_progress : "1-N"
    lessons ||--o{ user_lesson_progress : "1-N"
    grades ||--o{ user_lesson_progress : "1-N"
    types ||--o{ user_lesson_progress : "1-N"

