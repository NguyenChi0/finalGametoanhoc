PORT=5050

# MySQL — dùng RDS trên AWS (không dùng localhost trên production)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=3306
DB_USER=gametoanhoc
DB_PASSWORD=your-db-password
DB_NAME=gametoanhoc

JWT_SECRET=your-secret-here
JWT_EXPIRES_IN=1d

# URL frontend production (dùng cho link email xác thực / reset mật khẩu)
FRONTEND_URL=https://your-domain.com/gametoanhoc

# Gmail SMTP — bật 2FA, tạo App Password tại Google Account > Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM="Game Toán Học <your@gmail.com>"
